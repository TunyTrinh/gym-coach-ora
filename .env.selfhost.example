# Public hostname. Point its A/AAAA record to this machine before deployment.
APP_DOMAIN=gymflow.example.com
ACME_EMAIL=ops@example.com

# Generate unique values in a password manager; do not commit the real .env file.
MYSQL_DATABASE=gymflow
MYSQL_USER=gymflow
MYSQL_PASSWORD=replace-with-a-long-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password
JWT_SECRET=replace-with-a-64-character-random-session-secret
APP_ID=gymflow

# Register https://YOUR_DOMAIN/api/auth/google/callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Full compressed MySQL dump schedule and retention.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
